# ==============================================================================
# AIRMOD 환경 설정 예시 템플릿 (.env.example)
# 실제 값을 입력하지 말고, .env 파일에 실제 키를 입력하여 사용하세요.
# ==============================================================================

# OpenAI API 설정
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Supabase 데이터베이스 설정 (서버 전용)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 이미지 검색 API 설정 (Google Programmable Search)
IMAGE_SEARCH_API_KEY=
IMAGE_SEARCH_ENGINE_ID=

